<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- ================================================== -->
    <!-- CONSOLE APPENDER - USER INTERFACE ONLY            -->
    <!-- ================================================== -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>

    </appender>


    <!-- ================================================== -->
    <!-- ROLLING FILE APPENDER - TECHNICAL APPLICATION LOG -->
    <!-- ================================================== -->

    <appender name="ROLLING_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>logs/application.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                logs/application.%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>

            <maxHistory>30</maxHistory>

            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

        <encoder>

            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n
            </pattern>

        </encoder>

    </appender>


    <!-- ================================================== -->
    <!-- USER INTERFACE LOGGER                             -->
    <!-- ================================================== -->

    <logger name="com.instagram.ui"
            level="INFO"
            additivity="false">

        <appender-ref ref="CONSOLE"/>

    </logger>


    <!-- ================================================== -->
    <!-- APPLICATION LOGGER                                -->
    <!-- ================================================== -->

    <root level="INFO">

        <appender-ref ref="ROLLING_FILE"/>

    </root>

</configuration>